DATABASE_URL=postgres://retrouvid:retrouvid_dev@localhost:5432/retrouvid
JWT_SECRET=changez-moi-avec-une-longue-valeur-aleatoire
PORT=3000
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GEOCODE_URL=https://nominatim.openstreetmap.org
GEOCODE_PAYS=sn
GEOCODE_PAUSE_MS=1000
# Production derrière un proxy TLS : redirige http vers https et envoie HSTS. CORS_ORIGIN doit alors être en https.
FORCE_HTTPS=false

# --- Vérification du téléphone (code à 6 chiffres avant l'inscription et à chaque connexion) ---
# non : coupe la vérification (connexion en une étape). Toute autre valeur, ou rien : vérification active.
VERIF_TELEPHONE=oui
# simulation : aucun SMS réel, le code s'affiche à l'écran et dans le journal du serveur.
# Toute autre valeur masque le code ; aucun fournisseur SMS n'est encore branché.
SMS_MODE=simulation

# --- Paiement PayDunya (Wave, Orange Money) ---
# Clés à copier depuis votre application PayDunya (tableau de bord > Intégrer > Configurer une application).
# Elles ne vont JAMAIS dans le dossier web/ ni dans Git. Sans elles, le bouton de paiement affiche « pas encore ouvert ».
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test : bac à sable PayDunya, aucun argent réel. live : encaissement réel (clés « live » de l'application).
PAYDUNYA_MODE=test
# Moyens de paiement proposés. Vide = tous ceux que votre compte PayDunya a activés.
PAYDUNYA_CANAUX=wave-senegal,orange-money-senegal
# Adresse publique de la PWA : PayDunya y renvoie l'utilisateur après le paiement.
APP_URL=http://localhost:5173
# Adresse publique HTTPS de l'API : PayDunya y envoie la notification de paiement (IPN). À laisser vide en local :
# le paiement est alors confirmé au retour de l'utilisateur sur la page de suivi.
API_PUBLIC_URL=
